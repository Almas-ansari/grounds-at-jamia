# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). Both values are safe in a browser bundle: the anon
# key grants nothing on its own, because every table is behind RLS.
#
# `npm run doctor` will tell you what is still missing, here and in the
# Supabase dashboard.
#
# NOTE: the URL is the bare project origin. Do NOT paste the REST endpoint with
# /rest/v1/ on the end — supabase-js appends that itself, and with it there
# every request 404s.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Offer the email magic-link route as well as Google. Leave unset unless the
# Email provider is actually enabled in Supabase — a button that always errors
# is worse than no button.
# VITE_ENABLE_EMAIL_SIGNIN=true

# --- server-side only, never in the client bundle ---------------------------
# Needed by `npm run seed:phantoms`, which writes rows as six invented users.
# Keep this out of .env.local if you share your machine; the seed script
# refuses to run against anything that looks like production regardless.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to the project ref you consider production. The seed script aborts if
# SUPABASE_URL matches it.
PRODUCTION_SUPABASE_REF=
