{
  "name": "marauders-map-jamia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:campus": "tsx scripts/fetch-campus.ts",
    "seed:phantoms": "tsx scripts/seed-phantoms.ts",
    "db:push": "supabase db push",
    "test:rls": "./scripts/test-rls.sh",
    "test:all": "npm run test && npm run test:rls",
    "fetch:tiles": "tsx scripts/fetch-tiles.ts",
    "wash:tiles": "tsx scripts/wash-tiles.ts",
    "doctor": "tsx scripts/doctor.ts",
    "db:apply": "./scripts/apply-migrations.sh",
    "verify:live": "tsx scripts/verify-live.ts",
    "verify:realtime": "tsx scripts/verify-realtime.ts",
    "fetch:buildings": "tsx scripts/fetch-buildings.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/geojson": "^7946.0.15",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
